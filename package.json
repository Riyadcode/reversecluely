{
  "name": "arlclue",
  "version": "1.0.0",
  "description": "arlclue — AI interview assistant (fork of OpenCluely) with prep documents, EN/FR/AR language detection and system-audio capture",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --no-sandbox --disable-gpu",
    "test-speech": "node scripts/test-speech.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "clean": "rm -rf dist/",
    "rebuild": "npm run clean && npm run build",
    "release": "npm run clean && npm run build:all",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": {
    "name": "riyadcode"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/riyadcode/reversecluely"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@google/genai": "^2.9.0",
    "dotenv": "^16.3.1",
    "mammoth": "^1.13.0",
    "markdown": "^0.5.0",
    "marked": "^15.0.12",
    "microsoft-cognitiveservices-speech-sdk": "^1.40.0",
    "node-record-lpcm16": "^1.0.1",
    "pdf-parse": "^1.1.1",
    "prismjs": "^1.30.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.arlclue.app",
    "productName": "arlclue",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!*.md",
      "!.git/**/*",
      "!.env*",
      "!.venv-whisper/**/*",
      "!.whisper-models/**/*",
      "!bin/**/*",
      "!scripts/__pycache__/**/*",
      "!**/*.pyc",
      "!eng.traineddata",
      "!prep/**/*"
    ],
    "asarUnpack": [
      "assests/icons/**/*",
      "prompts/**/*",
      "scripts/whisper_worker.py",
      "node_modules/pdf-parse/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "arlclue uses the microphone to transcribe your speech locally with Whisper.",
        "NSCameraUsageDescription": "arlclue does not record video; this entitlement is only present for media-capture compatibility.",
        "NSScreenCaptureUsageDescription": "arlclue captures the screen to read on-screen content for AI assistance.",
        "NSAudioCaptureUsageDescription": "arlclue captures system audio so it can hear the interviewer through your headphones."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "sign": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assests/icons/app-icon.png",
      "category": "Utility"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xauth",
        "libasound2t64",
        "libgbm1",
        "python3 (>= 3.10)",
        "python3-venv",
        "python3-pip"
      ],
      "recommends": [
        "ffmpeg",
        "pulseaudio-utils"
      ],
      "fpm": [
        "--after-install=scripts/post-install-deb.sh"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "include": "scripts/post-install-nsis.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "arlclue-Setup-${version}.${ext}"
    },
    "dmg": {
      "title": "arlclue Interview Assistant",
      "backgroundColor": "#000000",
      "window": {
        "width": 600,
        "height": 400
      }
    }
  }
}
